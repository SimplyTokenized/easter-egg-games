{
  "name": "@simplytokenized/easter-egg-games",
  "version": "0.1.0",
  "private": true,
  "description": "A hidden arcade — six clicks on a host app's logo open a full-screen games modal. Ships behind a lazy boundary so the host bundle stays untouched.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": ">=1.1.0",
    "clsx": ">=2.0.0",
    "lucide-react": ">=0.400.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "tailwind-merge": ">=2.0.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@testing-library/react": "^16.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "happy-dom": "^15.11.6",
    "lucide-react": "^0.563.0",
    "postcss": "^8.4.47",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vitest": "^4.0.18"
  }
}
